# ============================================================
# CentPOS - Template Environment Variables (.env.example)
# Salin file ini menjadi .env.local untuk konfigurasi lokal
# ============================================================

# Nama Aplikasi
NEXT_PUBLIC_APP_NAME="CentPOS"

# Konfigurasi Supabase (Database Cloud PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Konfigurasi CentPay CMS (Multi-App Payment Gateway Configuration)
CENT_CMS_API_URL="https://cent-cms.vercel.app"
CENT_CMS_APP_SLUG="centpos"
CENT_CMS_APP_KEY="ck_live_centpos_9921a8b"

# Database Supabase milik CentPay CMS (untuk mengambil Server Key dari tabel app_gateaway_providers)
CENT_CMS_SUPABASE_URL="https://your-cms-supabase-project.supabase.co"
CENT_CMS_SUPABASE_SERVICE_KEY="your-cms-supabase-service-role-key"
